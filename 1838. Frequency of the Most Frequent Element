1838. Frequency of the Most Frequent Element

class Solution {
    public int maxFrequency(int[] nums, int k) {
        Arrays.sort(nums);
        int n=nums.length;
        for(int i=0;i<n-1;i++){
            nums[i]=nums[i+1]-nums[i];
        }
        nums[n-1]=0;
        int track=0,prev=0,j=n-1,ans=1;
        for(int i=n-1;i>=0;i--){
            if(i==j){
                prev=0;
                track=0;
                continue;
            }
            track+=prev+nums[i];
            prev+=nums[i];
            while(i<j && track>k){
                j--;
                track-=(j-i+1)*nums[j];
                prev-=nums[j];
            }
            ans=Math.max(ans,j-i+1);
             
        }
        return ans;
    }
}

Approach-2 Sliding Window (Improved)

public class Solution {
    public int maxFrequency(int[] nums, int k) {
        Arrays.sort(nums);
        
        int n = nums.length;
        
        int result = 0;
        
        int i = 0;
        long currSum = 0;
        
        for (int j = 0; j < n; j++) {
            
            long target = nums[j];
            currSum += nums[j];
            
            if ((j - i + 1) * target - currSum > k) {
                currSum -= nums[i];
                i++;
            }
            
            result = Math.max(result, j - i + 1);
            
        }
        return result;
    }
}
